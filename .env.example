# Copy to .env and fill in. Never commit .env.
# Free key: https://fredaccount.stlouisfed.org/apikeys
ATLAS_FRED_API_KEY=
# For `atlas ask`. Key from https://platform.claude.com/settings/keys
# (or leave empty and run `ant auth login`).
ANTHROPIC_API_KEY=
ATLAS_DATA_DIR=data
ATLAS_LOG_LEVEL=INFO
# Optional delivery of alerts and the weekly digest (see docs/runbooks.md).
# A private ntfy topic: https://ntfy.sh/<long random name>; subscribe to it in the ntfy app.
ATLAS_NTFY_TOPIC_URL=
# A Slack incoming webhook.
ATLAS_SLACK_WEBHOOK_URL=
